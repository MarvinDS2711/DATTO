# =============================================================================
# Datto — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# NE JAMAIS committer de vraies valeurs. Aucune de ces variables n'est préfixée
# NEXT_PUBLIC_ : elles restent strictement côté serveur.
# =============================================================================

# Source des données : "mock" (phase 1, données fictives) ou "datto" (API réelle,
# NON implémentée en phase 1 — le démarrage échoue volontairement si "datto").
DATTO_MODE=mock

# --- API Datto RMM (phase 2) -------------------------------------------------
# URL de l'API de votre plateforme Datto RMM (visible dans Setup > Global
# Settings > Access Control une fois l'accès API activé). Exemple de forme :
# https://<plateforme>-api.centrastage.net
DATTO_API_URL=
# Clé et secret API générés pour un utilisateur Datto RMM dédié, aux droits minimaux.
DATTO_API_KEY=
DATTO_API_SECRET=
# Délai maximal (ms) d'un appel à l'API Datto avant abandon.
DATTO_TIMEOUT_MS=15000

# --- Authentification de l'application (phase 2) -----------------------------
# Secret de signature/chiffrement des sessions (au moins 32 caractères aléatoires).
# Générer par exemple avec : openssl rand -base64 48
SESSION_SECRET=
# Durée de vie d'une session en secondes.
SESSION_MAX_AGE_SECONDS=28800

# --- Journalisation -----------------------------------------------------------
# Niveau : debug | info | warn | error
LOG_LEVEL=info
